#!/usr/bin/env python3
"""Privileged, asynchronous and offline-only Bedrock world export."""
import os,sys,json,pathlib,subprocess,zipfile,stat,time,grp,re,datetime
ROOT=pathlib.Path('/home/mcserver/minecraft_bedrock/worlds')
DIR=pathlib.Path('/var/lib/bedrock-panel/exports')
JOBS=pathlib.Path('/run/bedrock-panel-jobs')
MAX_FILES=30000
MAX_BYTES=2*1024**3

def offline():
    return (subprocess.run(['/usr/bin/systemctl','is-active','--quiet','mcbedrock.service']).returncode!=0
        and subprocess.run(['/usr/bin/pgrep','-u','mcserver','-x','bedrock_server'],stdout=subprocess.DEVNULL).returncode!=0)

def update(state,message,rc=None):
    data={'id':job,'action':'world-export','state':state,'message':message,'exit_status':rc,
          'world_name':name,'export_timestamp':export_timestamp}
    tmp=JOBS/('.'+job+'.tmp')
    tmp.write_text(json.dumps(data,ensure_ascii=False))
    os.chown(tmp,0,grp.getgrnam('www-data').gr_gid);os.chmod(tmp,0o640)
    os.replace(tmp,JOBS/(job+'.json'))

def archive():
    if not offline():raise ValueError('Minecraft muss für einen konsistenten Download gestoppt sein.')
    src=ROOT/name
    if src.is_symlink() or not src.is_dir() or not (src/'level.dat').is_file() or (src/'level.dat').is_symlink():
        raise ValueError('Ungültige Welt')
    # Avoid unbounded old exports. Files older than 24 hours are deleted.
    for f in DIR.glob('*'):
        if f.is_file() and not f.is_symlink() and re.fullmatch(r'[a-f0-9]{32}\.(zip|mcworld)',f.name) and time.time()-f.stat().st_mtime>86400:
            f.unlink(missing_ok=True)
    dest=DIR/(job+'.'+fmt)
    count=0;size=0
    try:
        with zipfile.ZipFile(dest,'w',compression=zipfile.ZIP_DEFLATED,compresslevel=6,allowZip64=True) as z:
            for base,dirs,files in os.walk(src,followlinks=False):
                dirs.sort();files.sort()
                for d in dirs:
                    st=(pathlib.Path(base)/d).lstat()
                    if not stat.S_ISDIR(st.st_mode):raise ValueError('Symlink oder Sonderdatei im Weltordner')
                for fn in files:
                    f=pathlib.Path(base)/fn;st=f.lstat()
                    if not stat.S_ISREG(st.st_mode) or st.st_nlink>1:raise ValueError('Links oder Sonderdateien sind nicht erlaubt')
                    count+=1;size+=st.st_size
                    if count>MAX_FILES or size>MAX_BYTES:raise ValueError('Welt überschreitet Sicherheitslimit (2 GiB / 30000 Dateien)')
                    relative=f.relative_to(src).as_posix()
                    arcname=(name+'/' if fmt=='zip' else '')+relative
                    z.write(f,arcname)
        if not offline():raise ValueError('Minecraft wurde während des Exports gestartet. Archiv verworfen.')
        os.chown(dest,0,grp.getgrnam('www-data').gr_gid);os.chmod(dest,0o640)
        update('success','Download bereit: '+fmt.upper(),0)
    except Exception:
        dest.unlink(missing_ok=True)
        raise

if __name__=='__main__':
    if len(sys.argv)!=4:sys.exit(2)
    job,name,fmt=sys.argv[1:]
    export_timestamp=datetime.datetime.now().astimezone().strftime('%Y%m%d-%H%M%S')
    if not re.fullmatch(r'[a-f0-9]{32}',job) or fmt not in ('zip','mcworld') or not (1<=len(name)<=80) or name!=name.strip() or name in ('.','..') or any(c in name for c in '/\\:\x00\r\n') or any(ord(c)<32 for c in name):sys.exit(2)
    try:
        update('running','Welt wird komprimiert …')
        archive()
    except Exception as e:
        update('failed','Export fehlgeschlagen: '+str(e)[:220],1)
        sys.exit(1)
