#!/usr/bin/env python3
"""Fetch only latest signed stable GitHub Release, then invoke validated local installer.
No request-controlled URLs, tags, paths or shell execution. Runs as root in systemd.
"""
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import urllib.request
import urllib.error
from pathlib import Path

# The new repository is preferred once it exists; the old one remains the
# supported source until GitHub is renamed. Never follow API redirects.
REPOSITORIES=('xDraconix/DracoRock-Control','xDraconix/Bedrock-Control')
CHANNEL_FILE=Path('/etc/bedrock-control-pro/update-channel')
STAGING=Path('/var/lib/bedrock-panel-update-staging')
KEY=Path('/etc/bedrock-control-pro/trusted-release-key.pem')
PANEL=Path('/opt/bedrock-control-pro')
APPLY='/usr/local/bin/bedrock-panel-apply-release'
MAX_ZIP=35*1024*1024

def fail(message):
    raise RuntimeError(message)

def run(*args, timeout=120):
    result=subprocess.run([str(a) for a in args],timeout=timeout,check=False)
    if result.returncode: fail('Befehl fehlgeschlagen: '+str(args[0]))

def fetch_release(channel):
    release=None
    source_repo=None
    for repo in REPOSITORIES:
        api='https://api.github.com/repos/'+repo+'/releases'
        api+= '?per_page=30' if channel=='test' else '/latest'
        req=urllib.request.Request(api,headers={
            'Accept':'application/vnd.github+json',
            'User-Agent':'DracoRock-Control/2.8.1',
            'X-GitHub-Api-Version':'2022-11-28'})
        # Before GitHub's rename, the DracoRock repository does not exist (404).
        # Only this condition permits a fallback to the legacy repository.
        try:
            with urllib.request.urlopen(req,timeout=15) as response:
                if response.url!=api: fail('GitHub API-Weiterleitung nicht erlaubt')
                raw=response.read(262145)
        except urllib.error.HTTPError as ex:
            if ex.code==404 and repo==REPOSITORIES[0]:
                continue
            raise
        if len(raw)>262144: fail('GitHub-Antwort zu groß')
        response=json.loads(raw)
        source_repo=repo
        if channel=='test':
            if not isinstance(response,list): fail('Ungültige GitHub Release-Liste')
            candidates=[r for r in response if isinstance(r,dict) and r.get('draft') is False
                and r.get('prerelease') is True and isinstance(r.get('tag_name'),str)
                and re.fullmatch(r'v\\d+\\.\\d+\\.\\d+',r['tag_name'])]
            if not candidates: fail('Keine veröffentlichten Pre-Releases gefunden')
            release=max(candidates,key=lambda r:tuple(map(int,r['tag_name'][1:].split('.'))))
        else:
            release=response
            if not isinstance(release,dict) or release.get('draft') is not False or release.get('prerelease') is not False:
                fail('Kein gültiges stabiles Release')
        break
    if source_repo is None: fail('Keine vertrauenswürdige GitHub-Release-Quelle gefunden')
    tag=release.get('tag_name')
    if not isinstance(tag,str) or not re.fullmatch(r'v\\d+\\.\\d+\\.\\d+',tag):
        fail('Ungültiger Release-Tag')
    # v2.8.1 keeps the legacy signed payload format, including the archive
    # name and signed manifest. Changing these requires a separate migration.
    names=[f'Bedrock-Control-PRO-{tag}-Release.zip']
    names.extend([names[0]+'.manifest',names[0]+'.manifest.sig'])
    owner_prefix='https://github.com/'+source_repo+'/releases/download/'
    assets={}
    for asset in release.get('assets',[]):
        if not isinstance(asset,dict):continue
        name,url=asset.get('name'),asset.get('browser_download_url')
        if name not in names or not isinstance(url,str):continue
        if url!=owner_prefix+tag+'/'+name:continue
        if name in assets:fail('Doppeltes Release-Asset')
        if not isinstance(asset.get('size'),int) or asset['size']<=0 or asset['size']>(MAX_ZIP if name.endswith('.zip') else 200000):fail('Unzulässige Asset-Größe')
        assets[name]=(url,asset['size'])
    if len(assets)!=3: fail('Release ist nicht vollständig signiert (ZIP + Manifest + Signatur)')
    return tag,names,assets

def download(url,dest,expected_size,max_size):
    # GitHub release downloads redirect to GitHub-owned asset/CDN endpoints.
    # Only HTTPS redirects are accepted. Authenticity is verified independently
    # using the already-installed trusted Ed25519 key before installing anything.
    result=subprocess.run(['/usr/bin/curl','--fail','--silent','--show-error',
        '--location','--max-redirs','5','--proto','=https','--proto-redir','=https',
        '--connect-timeout','8','--max-time','180','--max-filesize',str(max_size),
        '--output',str(dest),url],timeout=200,check=False)
    if result.returncode:fail('GitHub-Asset-Download fehlgeschlagen')
    if dest.is_symlink() or not dest.is_file() or dest.stat().st_size!=expected_size:
        fail('Downloadgröße stimmt nicht mit GitHub überein')
    os.chmod(dest,0o600)

def main():
    if os.geteuid()!=0:fail('Nur root erlaubt')
    st=STAGING.stat()
    if not STAGING.is_dir() or STAGING.is_symlink() or st.st_uid!=0 or stat.S_IMODE(st.st_mode)!=0o700:
        fail('Unsicheres Staging-Verzeichnis')
    if not KEY.is_file() or KEY.is_symlink() or KEY.stat().st_uid!=0 or (stat.S_IMODE(KEY.stat().st_mode)&0o022):
        fail('Vertrauenswürdiger Ed25519-Schlüssel fehlt oder hat unsichere Rechte')
    channel=CHANNEL_FILE.read_text(encoding='ascii').strip() if CHANNEL_FILE.is_file() and not CHANNEL_FILE.is_symlink() else 'stable'
    if channel not in ('stable','test'): fail('Ungültiger Updatekanal')
    print('Aktiver Updatekanal: '+channel,flush=True)
    tag,names,assets=fetch_release(channel)
    print('GitHub Release: '+tag,flush=True)
    # Local apply-release independently checks that the target is newer.
    with tempfile.TemporaryDirectory(dir=STAGING,prefix='.github-release-') as temp:
        os.chmod(temp,0o700)
        paths=[]
        for name in names:
            url,size=assets[name]
            dest=Path(temp)/name
            print('Lade signiertes Asset: '+name,flush=True)
            download(url,dest,size,MAX_ZIP if name.endswith('.zip') else 200000)
            paths.append(dest)
        print('Prüfe und installiere signiertes Release ...',flush=True)
        run(APPLY,'install-local',tag,*paths,'--confirm-update',timeout=900)
    print('Panel-Update erfolgreich abgeschlossen.',flush=True)

if __name__=='__main__':
    try:main()
    except Exception as ex:
        print('PANEL-UPDATE-FEHLER: '+str(ex),file=sys.stderr,flush=True)
        sys.exit(1)
